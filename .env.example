PORT=3000
NODE_ENV=development
# Exact frontend origins (scheme + hostname, no trailing slash).
# On Vercel replace with https://example.com,https://www.example.com
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Server only. Never put this key in frontend/ or cPanel public_html.
SUPABASE_SERVICE_ROLE_KEY=
# Create these users in Supabase Authentication first. No demo login fallback.
ADMIN_EMAILS=admin@yourdomain.com
# SMTP: server-side Vercel environment only. Use 465 for TLS or 587 for STARTTLS.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=info@velloxtech.com
# Optional fallback for requests that do not provide a frontend or proxy origin.
# SITE_URL=https://anviltools.vercel.app
