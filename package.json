{
  "name": "anvil-tools-admin",
  "version": "1.0.0",
  "description": "Anvil Tools: Vercel Express API, cPanel static frontend, Supabase database",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "dev:api": "node --watch server.js",
    "dev:frontend": "node scripts/serve-frontend.js",
    "test": "node --test tests/*.test.js",
    "verify": "node verify.js",
    "sitemap": "node scripts/build-sitemap.js",
    "build:editorial": "node scripts/build-editorial.js && node scripts/build-sitemap.js",
    "audit:crawl": "node scripts/check-crawl-readiness.js"
  },
  "keywords": [
    "static-site",
    "admin-panel",
    "supabase",
    "node"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@supabase/supabase-js": "^2.49.1",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "nodemailer": "^10.0.12",
    "sharp": "^0.35.5"
  },
  "engines": {
    "node": "22.x"
  }
}
